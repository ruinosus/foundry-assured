        }
      ]
    },
    {
      "id": "claim_771aceb9ded44507ac8f69d7fe4c98b5",
      "statement": "`apps/backend/tests/platform_ops/mcp_discovery_auth_test.py` verifies that MCP endpoint discovery authenticates late and only through approved seams: public endpoints send no auth header provider, connection-backed credentials are resolved lazily and once per session, connection refs are looked up in the current tenant, invalid or incompatible connections fail closed with `MCP_AUTH_NOT_AVAILABLE` before discovery runs, and OBO uses an allowlisted audience scope.",
      "evidence": [
        {
          "resource": "repo://apps/backend/tests/platform_ops/mcp_discovery_auth_test.py#L1-L17",
          "version": "repo-lines-v1:sha256:35a370b665c6e778bddd269359dcfde5c26290c394fd3e118f3a26beb8a3b8f3:"
