        }
      ]
    },
    {
      "id": "claim_28a676fb4d2d43ac82264fe6f1221145",
      "statement": "The MCP assurance shelf in CI is broader than one auth test: the workflow also runs gates for direct-endpoint approval behavior, egress isolation, classification, conformity, canonical drift hashing, selective drift quarantine, stale-review fail-closed behavior, secret-canary handling, adversarial discovery limits, stable content-free errors, observability, and tenant-isolated connections.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/ci.yml#L220-L280",
