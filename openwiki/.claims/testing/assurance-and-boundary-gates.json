    {
      "id": "claim_54eff56e1f924d7d97f28a3e7e92af28",
      "statement": "The CI workflow treats document-level access control as a fail-closed boundary, with dedicated gates for mutation-based whole-document denial, the HTTP `/source` contract, authorized-count behavior, `session` container coherence, and preservation of source-declared access metadata while keeping frontmatter out of retrieval text.",
      "evidence": [
        {
          "resource": "repo://.github/workflows/ci.yml#L47-L70",
