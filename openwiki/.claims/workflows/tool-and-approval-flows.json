    {
      "id": "claim_296afd74c20345a89c60e5e90eaceb80",
      "statement": "MCP endpoint discovery authenticates late and only against approved tenant-local origins: `discover_endpoint()` refuses missing or unapproved endpoints, derives a header provider only after loading the approved endpoint, validates the origin and public egress, lazily resolves `connection` or `obo` bearers through cached providers, and fails with `MCP_AUTH_NOT_AVAILABLE` when the connection or registered-origin checks do not match.",
      "evidence": [
        {
          "resource": "repo://apps/backend/app/modules/platform_ops/internal/mcp_egress.py#L181-L196",
          "version": "repo-lines-v1:sha256:8522fd874c2db510b7ca047773b9b97918a83add32f202a760aaf9a7836c8e41:"
