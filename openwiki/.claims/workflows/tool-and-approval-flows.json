    {
      "id": "claim_e5b1ee7c049048d5ba36525b7d2c1aeb",
      "statement": "Platform write safety is split between role-filtered tool exposure and native tool approval: the MCP registry classifies any tool not explicitly listed as a read as a write, `visible_tools_for()` only exposes tools whose server-level and connection-level grants are both satisfied, and the platform module relies on that ordering so approval middleware is only consulted for tools the caller is already entitled to run.",
      "evidence": [
        {
          "resource": "repo://apps/backend/app/modules/platform_ops/internal/mcp_registry.py#L130-L175",
