          "version": "repo-lines-v1:sha256:0089aa488556a67c5e0434df5aa927e17033482da02f28b766d776f4c5c4aade:"
        }
      ]
    },
    {
      "id": "claim_22a4bac1fda941f8960268fde9e19c23",
      "statement": "The graph-domain mount path uses an `APIRouter` wrapper because LangGraph's AG-UI adapter does not accept `dependencies=` directly; `_mount_graph` registers the adapter on the router and includes that router on the app with `domain_deps(domain_id)`, which is how `/oncall` and `/deepcall` receive auth and shared-mode entitlement checks.",
      "evidence": [
        {
          "resource": "repo://apps/backend/app/registry.py#L200-L247",
          "version": "repo-lines-v1:sha256:ea72f5391b45eb0c5504ba6933a600a7bc932abd881e8be1c93992ffa13ea6dc:"
        }
      ]
    },
    {
