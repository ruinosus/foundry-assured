    {
      "id": "claim_a5488de7eeae4ce5ab2b5e72de1f3c21",
      "statement": "Backend domain endpoints use a two-layer dependency contract: tenancy's `domain_deps(domain_id)` always applies auth and adds `require_domain(domain_id)` only in shared mode, while `app.registry.domain_deps(domain_id)` wraps that gate and appends the conversation-binding dependency so every mounted domain kind gets the same auth, entitlement, and conversation wiring.",
      "evidence": [
        {
          "resource": "repo://apps/backend/app/modules/tenancy/public.py#L113-L124",
          "version": "repo-lines-v1:sha256:9ebfafecbbbe562b8b322150c4d801acf53c2dc86b4b6b491d6fa1b73b8b9d63:"
        },
        {
