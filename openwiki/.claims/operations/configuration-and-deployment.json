  "claims": [
    {
      "id": "claim_9bb710b1bba04891ad619dd72098ec7c",
      "statement": "The repository deploys the backend, frontend web app, and MCP server as separate `azd` services, with `mcp` hosted as its own Container App and built from the repository root context because it depends on `apps/backend` by path.",
      "evidence": [
        {
          "resource": "repo://azure.yaml#L6-L26",
          "version": "repo-lines-v1:sha256:394869dbb5ca3e2cb1a0dcad56e44b5853ca2e951cbb9dfc6049f69d999a97fa:"
        }
      ]
    },
    {
      "id": "claim_d54144ba7d734e9087039dfc759a3047",
      "statement": "The backend `.env.example` is organized around operational seams including Foundry, Search/Storage, Entra auth, ACLs, per-domain knowledge bases, MCP settings, shared-mode tenant store settings, and optional observability/tuning values.",
      "evidence": [
        {
          "resource": "repo://apps/backend/.env.example#L13-L128",
          "version": "repo-lines-v1:sha256:7965b3224c15e404ce40585b5609e5375d5f2b1ae46310ecf3b64a9df66d3855:"
        }
      ]
    },
    {
      "id": "claim_5e381277611c4126b0c5a90ccb34b090",
      "statement": "`app/shared/settings.py` intentionally keeps only platform-global settings, defaults `deployment_mode` to `self_hosted`, treats auth as enabled only when the Entra API registration is configured, and uses `http://localhost:8001` as the default public base URL for the standalone MCP server in development.",
      "evidence": [
        {
          "resource": "repo://apps/backend/app/shared/settings.py#L1-L128",
          "version": "repo-lines-v1:sha256:ebe09693dc91c4938a6244190a4e790daf19da8b695dbc00d668fd93c7dc6baa:"
        }
      ]
    },
    {
      "id": "claim_e67a71df4cce474194f739ece55bc7a6",
      "statement": "The frontend configuration is intentionally thin: `BACKEND_URL` is the base seam, domain AG-UI URLs derive from it unless overridden, and browser-visible switches include `NEXT_PUBLIC_FRONTEND_MODE`, `NEXT_PUBLIC_DATA_MODE`, `NEXT_PUBLIC_ENTRA_*`, and optional `NEXT_PUBLIC_DEMO_MODE`.",
      "evidence": [
        {
          "resource": "repo://apps/frontend/.env.example#L1-L28",
          "version": "repo-lines-v1:sha256:eb76617a6d80f23204a9d9db1db923dce3f38c4284e362e32925bbdc62d7f736:"
        }
      ]
    },
    {
      "id": "claim_004d07d559d34982a350db4208eaaab9",
      "statement": "Frontend mode and data mode are validated against fixed allowed values and fall back to `legacy` and `connected` respectively, with `isLocalDataMode` derived from the normalized data mode.",
      "evidence": [
        {
          "resource": "repo://apps/frontend/lib/frontend-mode.ts#L1-L23",
          "version": "repo-lines-v1:sha256:87ea89e8cf07e0d1d3b71fb4c57246e34d978c4507af3ad8abff85fa04a5c615:"
        }
