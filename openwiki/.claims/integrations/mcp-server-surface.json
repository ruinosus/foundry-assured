    {
      "id": "claim_dc5738c07e634abfb3913e09b0960b09",
      "statement": "The MCP completion handler is a separately registered surface whose read-role gate is enforced manually because FastMCP does not apply template auth to `completion/complete`; it therefore fail-closes to empty suggestions when the caller lacks role, identity, tenant entitlement, or a valid grounded domain context.",
      "evidence": [
        {
          "resource": "repo://apps/mcp/mcp_app/resources_knowledge.py#L17-L25",
          "version": "repo-lines-v1:sha256:f2d41b9024f4c6b27b648f74e312f9f9abc47e9a59e3dafd7334c526ac03cebb:"
