  "claims": [
    {
      "id": "claim_d5df05616e414eef8e8059a9de2995e6",
      "statement": "The MCP server is a standalone FastMCP app whose composition root wires shared backend seams, registers the server surfaces in one place, and serves the MCP endpoint at `/mcp/` as the product's only MCP surface.",
      "evidence": [
        {
          "resource": "repo://apps/mcp/README.md#L175-L179",
          "version": "repo-lines-v1:sha256:c394e23c784c7b6557dc1c8a4a319d64995e086c769084312fc0a7a6ccbb99b2:"
        },
        {
          "resource": "repo://apps/mcp/mcp_app/main.py#L1-L27",
          "version": "repo-lines-v1:sha256:10bdc56b88bf8e762c04563aea1900716fe9de3137dcac3f5f4024b899382da9:"
        },
        {
          "resource": "repo://apps/mcp/mcp_app/main.py#L102-L139",
          "version": "repo-lines-v1:sha256:a0c400f8caaf67f4c226b80211920cbe2970ee4a9547b1ca47a776dd8fa0dcfa:"
        },
        {
          "resource": "repo://apps/mcp/mcp_app/main.py#L139-L231",
          "version": "repo-lines-v1:sha256:1314d79f9e43bd69544c8801243ee2bdeeb59d934c81a52c6ba458b1deb1fb74:"
        }
      ]
    },
    {
      "id": "claim_aa9c525e704947d3988379ea91d0b6b4",
      "statement": "The MCP app is deployed separately because FastMCP 4 and the backend's agent-framework stack require incompatible `mcp` major versions, so the app reuses backend business modules without the backend `agents` extra instead of sharing the backend runtime.",
      "evidence": [
        {
          "resource": "repo://apps/mcp/README.md#L181-L192",
          "version": "repo-lines-v1:sha256:bbc2a15abe450733b14bd58a34b9ba0637cee7238bd31ace8bfd3d5269678479:"
        }
      ]
    },
    {
      "id": "claim_9c815cea63d74d5fa100d5c7d51dbc91",
      "statement": "The shared domain catalog used by both the backend and the MCP app is exported from `app.modules.domains.public`, so both composition roots consume the same `DOMAIN_KINDS` and domain lookup functions instead of maintaining separate domain lists.",
