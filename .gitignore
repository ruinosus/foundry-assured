# Generated / local artifacts
# `bicep build infra/main.bicep` (the CI infra gate, run locally) drops the compiled
# ARM template next to the source — it is output, not source.
infra/main.json
copilotkit-events-*.json
apps/backend/eval/runs.jsonl
apps/backend/data/
apps/backend/eval/datasets/cockpit_golden.jsonl

# GitHub App / TLS private keys — never commit
*.pem

# Local-only notes that may hold secrets (e.g. TEST-CREDENTIALS.local.md) — never commit
*.local.md

# E2E (Playwright)
e2e/node_modules/
e2e/artifacts/
e2e/.auth/
e2e/test-results/
apps/backend/.cockpit-acl-poc.json
TEST-CREDENTIALS.local.md

# DNA SDLC board — per-workstation pointer (written by `dna sdlc story start`)
.dna/active-story.txt

# Local ticket store written at runtime by the helpdesk/oncall approval flow. It lands inside
# the package (app/modules/data/) because tickets.py anchors on its own file — worth fixing,
# but the data itself is never repository content.
apps/backend/app/modules/data/
experimento-mcp.sh
reingestar-selfwiki.sh

# Claude Code — a config do time é versionada; overrides pessoais não
.claude/settings.local.json
