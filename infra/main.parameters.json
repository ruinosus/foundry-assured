{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "principalId": { "value": "${AZURE_PRINCIPAL_ID}" },
    "principalType": { "value": "${AZURE_PRINCIPAL_TYPE}" },
    "ciPrincipalId": { "value": "${AZURE_CI_PRINCIPAL_ID}" },
    "searchLocation": { "value": "${AZURE_SEARCH_LOCATION}" },
    "deploySearch": { "value": "${DEPLOY_SEARCH=true}" },
    "entraTenantId": { "value": "${ENTRA_TENANT_ID}" },
    "entraApiClientId": { "value": "${ENTRA_API_CLIENT_ID}" },
    "entraApiClientSecret": { "value": "${ENTRA_API_CLIENT_SECRET}" },
    "mcpRequestStateKey": { "value": "${MCP_REQUEST_STATE_KEY}" },
    "appUsersGroupId": { "value": "${APP_USERS_GROUP_ID}" }
  }
}
